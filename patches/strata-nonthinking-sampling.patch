+++ b/serve/test_sampling_modes.py
@@ -0,0 +1,57 @@
+"""Model-specific thinking and non-thinking defaults, with client overrides."""
+
+import threading
+import unittest
+
+from serve.server import ByteTokenizer, MockEngine, Service, sampling_defaults_from_config
+
+
+class RecordingEngine(MockEngine):
+    def generate(self, ids, max_new, sampling, cancel, embeddings=None):
+        self.sampling = dict(sampling or {})
+        yield from super().generate(ids, max_new, sampling, cancel, embeddings)
+
+
+class SamplingModes(unittest.TestCase):
+    def run_case(self, thinking, request=None, shared=None, nonthinking=None):
+        tok = ByteTokenizer()
+        engine = RecordingEngine(tok, "</think>Done.")
+        service = Service(engine, tok, None,
+                          sampling_defaults={"temperature": 1., "top_p": .95, "top_k": 20,
+                                             "presence_penalty": 0., "repetition_penalty": 1.},
+                          nonthinking_sampling_defaults=nonthinking)
+        service.shared = shared or {}
+        list(service.run([], thinking, [], 100, request or {}, threading.Event()))
+        return engine.sampling
+
+    def test_thinking_uses_original_defaults(self):
+        result = self.run_case(True, nonthinking={"temperature": .7, "presence_penalty": 1.5})
+        self.assertEqual(result["temperature"], 1.)
+        self.assertEqual(result["presence_penalty"], 0.)
+
+    def test_nonthinking_overlays_and_retains_other_defaults(self):
+        result = self.run_case(False, nonthinking={"temperature": .7, "top_p": .8, "presence_penalty": 1.5})
+        self.assertEqual(result["temperature"], .7)
+        self.assertEqual(result["top_p"], .8)
+        self.assertEqual(result["presence_penalty"], 1.5)
+        self.assertEqual(result["top_k"], 20)
+        self.assertEqual(result["repetition_penalty"], 1.)
+
+    def test_request_zero_and_shared_settings_win_null_inherits(self):
+        result = self.run_case(False, {"temperature": 0, "presence_penalty": 0, "top_p": None},
+                               {"top_p": .9}, {"temperature": .7, "top_p": .8, "presence_penalty": 1.5})
+        self.assertEqual(result["temperature"], 0)
+        self.assertEqual(result["presence_penalty"], 0)
+        self.assertEqual(result["top_p"], .9)
+
+    def test_omitted_block_preserves_previous_behavior(self):
+        self.assertEqual(self.run_case(False), self.run_case(True))
+
+    def test_nonthinking_block_uses_existing_validation(self):
+        for invalid in ({"temperature": -1}, {"presence_penalty": -1}, {"top_p": 0}):
+            with self.assertRaises(SystemExit):
+                sampling_defaults_from_config({"sampling": invalid})
+
+
+if __name__ == "__main__":
+    unittest.main()
